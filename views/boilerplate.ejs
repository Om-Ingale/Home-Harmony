<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title : 'Home Harmony' %></title>

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Google Fonts: Playfair Display + DM Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />

  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>

  <!-- Custom styles -->
  <link rel="stylesheet" href="/css/style.css" />

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            display: ['"Playfair Display"', 'serif'],
            body:    ['"DM Sans"', 'sans-serif'],
          },
          colors: {
            brand: {
              50:  '#fdf6ee',
              100: '#faecd8',
              200: '#f4d4a8',
              300: '#ecb46e',
              400: '#e49040',
              500: '#dc7420',
              600: '#ce5c18',
              700: '#ab4416',
              800: '#893619',
              900: '#6e2e17',
            },
            stone: {
              950: '#0c0a09',
            }
          },
        },
      },
    };
  </script>
</head>

<body class="font-body bg-stone-50 text-stone-800 min-h-screen flex flex-col">

  <%- include('includes/navbar') %>

  <!-- Flash Messages -->
  <div class="max-w-7xl mx-auto w-full px-4 pt-4">
    <% if (success && success.length) { %>
      <div class="flash-success flex items-center gap-3 bg-emerald-50 border border-emerald-200 text-emerald-800 px-4 py-3 rounded-xl mb-4" role="alert">
        <i data-lucide="check-circle-2" class="w-5 h-5 shrink-0 text-emerald-500"></i>
        <p class="text-sm font-medium"><%= success[0] %></p>
        <button onclick="this.parentElement.remove()" class="ml-auto text-emerald-400 hover:text-emerald-600">
          <i data-lucide="x" class="w-4 h-4"></i>
        </button>
      </div>
    <% } %>
    <% if (error && error.length) { %>
      <div class="flash-error flex items-center gap-3 bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-xl mb-4" role="alert">
        <i data-lucide="alert-circle" class="w-5 h-5 shrink-0 text-red-400"></i>
        <p class="text-sm font-medium"><%= error[0] %></p>
        <button onclick="this.parentElement.remove()" class="ml-auto text-red-400 hover:text-red-600">
          <i data-lucide="x" class="w-4 h-4"></i>
        </button>
      </div>
    <% } %>
  </div>

  <!-- Page Content -->
  <main class="flex-1">
    <%- body %>
  </main>

  <%- include('includes/footer') %>

  <!-- Init Lucide icons -->
  <script>lucide.createIcons();</script>
  <script src="/js/main.js"></script>
</body>
</html>