<%- layout('boilerplate') %>

<div class="max-w-xl mx-auto px-4 sm:px-6 py-10">
  <div class="mb-8">
    <h1 class="font-display text-3xl font-bold text-stone-900">Edit Profile</h1>
    <p class="text-stone-500 mt-1">Update your account information</p>
  </div>

  <!-- Avatar preview -->
  <div
    class="flex items-center gap-5 mb-8 bg-white rounded-2xl border border-stone-100 shadow-sm p-6"
  >
    <img
      src="<%= user.avatar.url %>"
      alt="<%= user.username %>"
      class="w-20 h-20 rounded-full object-cover border-4 border-brand-100 shadow-md"
    />
    <div>
      <p class="font-semibold text-stone-800 text-lg"><%= user.username %></p>
      <p class="text-stone-400 text-sm"><%= user.email %></p>
      <span
        class="inline-block mt-1 text-xs px-2 py-0.5 rounded-full capitalize <%= user.role === 'admin' ? 'bg-purple-100 text-purple-700' : 'bg-stone-100 text-stone-600' %>"
      >
        <%= user.role %>
      </span>
    </div>
  </div>

  <form
    action="/profile?_method=PUT"
    method="POST"
    class="bg-white rounded-2xl border border-stone-100 shadow-sm p-8 space-y-6"
  >
    <!-- Username -->
    <div>
      <label
        class="block text-sm font-medium text-stone-700 mb-1.5"
        for="username"
      >
        Username <span class="text-red-400">*</span>
      </label>
      <input
        type="text"
        name="username"
        id="username"
        required
        value="<%= user.username %>"
        class="w-full border border-stone-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-300"
      />
    </div>

    <!-- Email -->
    <div>
      <label
        class="block text-sm font-medium text-stone-700 mb-1.5"
        for="email"
      >
        Email <span class="text-red-400">*</span>
      </label>
      <input
        type="email"
        name="email"
        id="email"
        required
        value="<%= user.email %>"
        class="w-full border border-stone-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-300"
      />
    </div>

    <!-- Phone -->
    <div>
      <label
        class="block text-sm font-medium text-stone-700 mb-1.5"
        for="phone"
      >
        Phone <span class="text-stone-400 font-normal text-xs">(optional)</span>
      </label>
      <input
        type="tel"
        name="phone"
        id="phone"
        value="<%= user.phone || '' %>"
        placeholder="+91 98765 43210"
        class="w-full border border-stone-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-300"
      />
    </div>

    <!-- Info note -->
    <div
      class="bg-amber-50 border border-amber-200 rounded-xl px-4 py-3 text-xs text-amber-700 flex items-start gap-2"
    >
      <i data-lucide="info" class="w-4 h-4 shrink-0 mt-0.5"></i>
      <span
        >To change your password, use the
        <a href="/auth/forgot-password" class="underline font-medium"
          >Forgot Password</a
        >
        flow. Avatar changes are not supported yet.</span
      >
    </div>

    <!-- Submit -->
    <div class="pt-2 flex gap-3">
      <button
        type="submit"
        class="flex-1 bg-brand-500 hover:bg-brand-600 text-white font-semibold py-3 rounded-xl transition-colors shadow-sm"
      >
        Save Changes
      </button>
      <a
        href="/products"
        class="px-6 py-3 border border-stone-200 text-stone-600 rounded-xl hover:bg-stone-50 transition-colors text-sm font-medium flex items-center"
      >
        Cancel
      </a>
    </div>
  </form>
</div>
