<%- layout('boilerplate') %>

<div class="min-h-[80vh] flex items-center justify-center px-4 py-12">
  <div class="w-full max-w-md">
    <div class="text-center mb-8">
      <div
        class="inline-flex items-center justify-center w-14 h-14 bg-brand-100 rounded-2xl mb-4"
      >
        <i data-lucide="user-plus" class="w-7 h-7 text-brand-500"></i>
      </div>
      <h1 class="font-display text-3xl font-bold text-stone-900">
        Create an account
      </h1>
      <p class="text-stone-500 mt-2 text-sm">
        Join Home Harmony and start exploring
      </p>
    </div>

    <div class="bg-white rounded-2xl border border-stone-100 shadow-sm p-8">
      <form action="/auth/register" method="POST" class="space-y-5">
        <div>
          <label
            class="block text-sm font-medium text-stone-700 mb-1.5"
            for="username"
            >Username</label
          >
          <input
            type="text"
            name="username"
            id="username"
            required
            autocomplete="username"
            placeholder="Enter username"
            class="w-full border border-stone-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-300"
          />
        </div>

        <div>
          <label
            class="block text-sm font-medium text-stone-700 mb-1.5"
            for="email"
            >Email</label
          >
          <input
            type="email"
            name="email"
            id="email"
            required
            autocomplete="email"
            placeholder="user@example.com"
            class="w-full border border-stone-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-300"
          />
        </div>

        <div>
          <label
            class="block text-sm font-medium text-stone-700 mb-1.5"
            for="phone"
            >Phone (optional)</label
          >
          <input
            type="tel"
            name="phone"
            id="phone"
            autocomplete="tel"
            placeholder="+91 00000 00000"
            class="w-full border border-stone-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-300"
          />
        </div>

        <div>
          <label
            class="block text-sm font-medium text-stone-700 mb-1.5"
            for="password"
          >
            Enter Password</label
          >
          <div class="relative">
            <input
              type="password"
              name="password"
              id="password"
              required
              autocomplete="new-password"
              placeholder="Min. 8 characters"
              class="w-full border border-stone-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-300 pr-10"
            />
            <button
              type="button"
              id="toggle-password"
              class="absolute right-3 top-1/2 -translate-y-1/2 text-stone-400 hover:text-stone-600"
            >
              <i data-lucide="eye" class="w-4 h-4"></i>
            </button>
          </div>
        </div>

        <button
          type="submit"
          class="w-full bg-brand-500 hover:bg-brand-600 text-white font-semibold py-3 rounded-xl transition-colors shadow-sm text-sm"
        >
          Create Account
        </button>
      </form>

      <p class="text-center text-sm text-stone-500 mt-6">
        Already have an account?
        <a
          href="/auth/login"
          class="text-brand-500 hover:text-brand-600 font-medium"
          >Sign in</a
        >
      </p>
    </div>
  </div>
</div>
