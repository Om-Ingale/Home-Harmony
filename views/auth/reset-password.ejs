<%- layout('boilerplate') %>

<div class="min-h-[70vh] flex items-center justify-center px-4 py-12">
  <div class="w-full max-w-md">
    <div class="text-center mb-8">
      <div
        class="w-14 h-14 bg-brand-100 rounded-2xl flex items-center justify-center mx-auto mb-4"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="#dc7420"
          stroke-width="2"
          class="w-7 h-7"
        >
          <rect x="3" y="11" width="18" height="11" rx="2" />
          <path d="M7 11V7a5 5 0 0 1 10 0v4" />
        </svg>
      </div>
      <h1 class="font-display text-3xl font-bold text-stone-900">
        Set new password
      </h1>
      <p class="text-stone-500 mt-2 text-sm">
        Choose a strong password for your account
      </p>
    </div>

    <div class="bg-white rounded-2xl border border-stone-100 shadow-sm p-8">
      <form
        action="/auth/reset-password"
        method="POST"
        class="space-y-5"
        id="reset-form"
      >
        <!-- New Password -->
        <div>
          <label class="block text-sm font-medium text-stone-700 mb-1.5">
            New Password
          </label>
          <div class="relative">
            <input
              type="password"
              name="password"
              id="password"
              required
              minlength="6"
              placeholder="At least 6 characters"
              class="w-full border border-stone-200 rounded-xl px-4 py-2.5 pr-11 text-sm focus:outline-none focus:ring-2 focus:ring-brand-300 transition-colors"
              oninput="
                checkStrength(this.value);
                checkMatch();
              "
            />
            <button
              type="button"
              onclick="togglePassword('password', 'eye1')"
              class="absolute right-3 top-1/2 -translate-y-1/2 text-stone-400 hover:text-stone-600 transition-colors"
            >
              <svg
                id="eye1"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                class="w-4 h-4"
              >
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                <circle cx="12" cy="12" r="3" />
              </svg>
            </button>
          </div>

          <!-- Strength bar -->
          <div class="mt-2 space-y-1.5">
            <div class="flex gap-1">
              <div
                id="bar-1"
                class="h-1 flex-1 rounded-full bg-stone-200 transition-all"
              ></div>
              <div
                id="bar-2"
                class="h-1 flex-1 rounded-full bg-stone-200 transition-all"
              ></div>
              <div
                id="bar-3"
                class="h-1 flex-1 rounded-full bg-stone-200 transition-all"
              ></div>
              <div
                id="bar-4"
                class="h-1 flex-1 rounded-full bg-stone-200 transition-all"
              ></div>
            </div>
            <p id="strength-text" class="text-xs text-stone-400"></p>
          </div>
        </div>

        <!-- Confirm Password -->
        <div>
          <label class="block text-sm font-medium text-stone-700 mb-1.5">
            Confirm Password
          </label>
          <div class="relative">
            <input
              type="password"
              name="confirmPassword"
              id="confirmPassword"
              required
              minlength="6"
              placeholder="Repeat your password"
              class="w-full border border-stone-200 rounded-xl px-4 py-2.5 pr-11 text-sm focus:outline-none focus:ring-2 focus:ring-brand-300 transition-colors"
              oninput="checkMatch()"
            />
            <button
              type="button"
              onclick="togglePassword('confirmPassword', 'eye2')"
              class="absolute right-3 top-1/2 -translate-y-1/2 text-stone-400 hover:text-stone-600 transition-colors"
            >
              <svg
                id="eye2"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                class="w-4 h-4"
              >
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                <circle cx="12" cy="12" r="3" />
              </svg>
            </button>
          </div>
          <!-- Match indicator -->
          <p id="match-text" class="text-xs mt-1.5 hidden"></p>
        </div>

        <!-- Password rules -->
        <div class="bg-stone-50 rounded-xl p-4 space-y-2">
          <p class="text-xs font-medium text-stone-600 mb-2">
            Password must have:
          </p>
          <div class="space-y-1.5">
            <div class="flex items-center gap-2" id="rule-length">
              <div
                class="w-4 h-4 rounded-full bg-stone-200 flex items-center justify-center shrink-0 transition-all"
                id="rule-length-icon"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="white"
                  stroke-width="3"
                  class="w-2.5 h-2.5 hidden"
                  id="rule-length-check"
                >
                  <path d="M20 6L9 17l-5-5" />
                </svg>
              </div>
              <span class="text-xs text-stone-500" id="rule-length-text">
                At least 6 characters
              </span>
            </div>
            <div class="flex items-center gap-2" id="rule-upper">
              <div
                class="w-4 h-4 rounded-full bg-stone-200 flex items-center justify-center shrink-0 transition-all"
                id="rule-upper-icon"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="white"
                  stroke-width="3"
                  class="w-2.5 h-2.5 hidden"
                  id="rule-upper-check"
                >
                  <path d="M20 6L9 17l-5-5" />
                </svg>
              </div>
              <span class="text-xs text-stone-500" id="rule-upper-text">
                One uppercase letter
              </span>
            </div>
            <div class="flex items-center gap-2" id="rule-number">
              <div
                class="w-4 h-4 rounded-full bg-stone-200 flex items-center justify-center shrink-0 transition-all"
                id="rule-number-icon"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="white"
                  stroke-width="3"
                  class="w-2.5 h-2.5 hidden"
                  id="rule-number-check"
                >
                  <path d="M20 6L9 17l-5-5" />
                </svg>
              </div>
              <span class="text-xs text-stone-500" id="rule-number-text">
                One number
              </span>
            </div>
          </div>
        </div>

        <!-- Submit -->
        <button
          type="submit"
          id="submit-btn"
          class="w-full bg-brand-500 hover:bg-brand-600 text-white font-semibold py-3 rounded-xl transition-colors shadow-sm flex items-center justify-center gap-2"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            class="w-4 h-4"
          >
            <rect x="3" y="11" width="18" height="11" rx="2" />
            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
          </svg>
          Reset Password
        </button>

        <p class="text-center text-xs text-stone-400">
          Remember your password?
          <a
            href="/auth/login"
            class="text-brand-500 hover:underline font-medium"
            >Sign in</a
          >
        </p>
      </form>
    </div>
  </div>
</div>

<script>
  // ── Toggle password visibility ─────────────────────────────────────────────
  function togglePassword(inputId, eyeId) {
    const input = document.getElementById(inputId);
    const eye = document.getElementById(eyeId);
    const isHidden = input.type === "password";
    input.type = isHidden ? "text" : "password";

    // Swap icon between eye and eye-off
    eye.innerHTML = isHidden
      ? `<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/>
         <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/>
         <line x1="1" y1="1" x2="23" y2="23"/>`
      : `<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
         <circle cx="12" cy="12" r="3"/>`;
  }

  // ── Password strength checker ──────────────────────────────────────────────
  function checkStrength(val) {
    const bars = [1, 2, 3, 4].map((i) => document.getElementById("bar-" + i));
    const text = document.getElementById("strength-text");

    const hasLength = val.length >= 6;
    const hasUpper = /[A-Z]/.test(val);
    const hasNumber = /\d/.test(val);
    const hasSymbol = /[^a-zA-Z0-9]/.test(val);

    // Update rules
    updateRule("length", hasLength);
    updateRule("upper", hasUpper);
    updateRule("number", hasNumber);

    // Strength score 0-4
    const score = [hasLength, hasUpper, hasNumber, hasSymbol].filter(
      Boolean,
    ).length;

    const colors = [
      "bg-stone-200",
      "bg-red-400",
      "bg-amber-400",
      "bg-yellow-400",
      "bg-emerald-500",
    ];
    const labels = ["", "Weak", "Fair", "Good", "Strong"];
    const textColors = [
      "text-stone-400",
      "text-red-500",
      "text-amber-500",
      "text-yellow-600",
      "text-emerald-600",
    ];

    bars.forEach((bar, i) => {
      bar.className = `h-1 flex-1 rounded-full transition-all ${
        i < score ? colors[score] : "bg-stone-200"
      }`;
    });

    text.textContent = score > 0 ? labels[score] : "";
    text.className = `text-xs ${textColors[score]}`;
  }

  function updateRule(rule, passed) {
    const icon = document.getElementById(`rule-${rule}-icon`);
    const check = document.getElementById(`rule-${rule}-check`);
    const txt = document.getElementById(`rule-${rule}-text`);

    if (passed) {
      icon.classList.remove("bg-stone-200");
      icon.classList.add("bg-emerald-500");
      check.classList.remove("hidden");
      txt.classList.remove("text-stone-500");
      txt.classList.add("text-emerald-600");
    } else {
      icon.classList.add("bg-stone-200");
      icon.classList.remove("bg-emerald-500");
      check.classList.add("hidden");
      txt.classList.add("text-stone-500");
      txt.classList.remove("text-emerald-600");
    }
  }

  // ── Password match checker ─────────────────────────────────────────────────
  function checkMatch() {
    const pass = document.getElementById("password").value;
    const confirm = document.getElementById("confirmPassword").value;
    const matchTx = document.getElementById("match-text");
    const confirmInput = document.getElementById("confirmPassword");

    if (!confirm) {
      matchTx.classList.add("hidden");
      return;
    }

    matchTx.classList.remove("hidden");

    if (pass === confirm) {
      matchTx.textContent = "✓ Passwords match";
      matchTx.className = "text-xs mt-1.5 text-emerald-600 font-medium";
      confirmInput.classList.remove("border-red-300", "focus:ring-red-200");
      confirmInput.classList.add(
        "border-emerald-300",
        "focus:ring-emerald-100",
      );
    } else {
      matchTx.textContent = "✗ Passwords do not match";
      matchTx.className = "text-xs mt-1.5 text-red-500 font-medium";
      confirmInput.classList.add("border-red-300", "focus:ring-red-200");
      confirmInput.classList.remove(
        "border-emerald-300",
        "focus:ring-emerald-100",
      );
    }
  }

  // ── Form submit guard ──────────────────────────────────────────────────────
  document.getElementById("reset-form").addEventListener("submit", (e) => {
    const pass = document.getElementById("password").value;
    const confirm = document.getElementById("confirmPassword").value;

    if (pass !== confirm) {
      e.preventDefault();
      document.getElementById("match-text").textContent =
        "✗ Passwords do not match";
      document.getElementById("match-text").className =
        "text-xs mt-1.5 text-red-500 font-medium";
      document.getElementById("confirmPassword").focus();
      return;
    }

    if (pass.length < 6) {
      e.preventDefault();
      document.getElementById("password").focus();
    }
  });
</script>
