<nav class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-stone-100 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 group">
        <div class="w-10 h-10 bg-brand-500 rounded-lg flex items-center justify-center shadow-md group-hover:bg-brand-600 group-hover:shadow-lg transition-all">
          <i data-lucide="home" class="w-5 h-5 text-white"></i>
        </div>
        <span class="font-display font-700 text-2xl text-stone-900 tracking-tight">
          Home<span class="text-brand-500">Harmony</span>
        </span>
      </a>

      <!-- Desktop Nav -->
      <div class="hidden md:flex items-center gap-6">
        <a href="/products"           class="text-base font-medium text-stone-600 hover:text-brand-500 hover:bg-stone-50 px-3 py-2 rounded-lg transition-all">Browse</a>
        <a href="/products?type=rent" class="text-base font-medium text-stone-600 hover:text-brand-500 hover:bg-stone-50 px-3 py-2 rounded-lg transition-all">Rent</a>
        <a href="/products?type=buy"  class="text-base font-medium text-stone-600 hover:text-brand-500 hover:bg-stone-50 px-3 py-2 rounded-lg transition-all">Buy</a>
        <a href="/products?type=sell" class="text-base font-medium text-stone-600 hover:text-brand-500 hover:bg-stone-50 px-3 py-2 rounded-lg transition-all">Sell</a>
      </div>

      <!-- Auth Buttons -->
      <div class="flex items-center gap-3">
        <% if (currentUser) { %>
          <a href="/products/new"
             class="hidden sm:flex items-center gap-1.5 text-sm font-medium bg-brand-500 hover:bg-brand-600 text-white px-4 py-2 rounded-lg transition-colors shadow-sm">
            <i data-lucide="plus" class="w-4 h-4"></i> List Item
          </a>

          <% if (currentUser.role === 'admin') { %>
            <a href="/admin"
               class="hidden sm:flex items-center gap-1.5 text-sm font-medium text-stone-700 hover:text-brand-600 transition-colors px-3 py-2">
              <i data-lucide="shield" class="w-4 h-4"></i> Admin Panel
            </a>
          <% } %>

          <!-- User Avatar + Dropdown -->
          <div class="relative group">
            <button class="flex items-center gap-2 pl-2 pr-3 py-1.5 rounded-full hover:bg-stone-100 transition-colors">
              <img src="<%= currentUser.avatar.url %>" alt="<%= currentUser.username %>"
                   class="w-7 h-7 rounded-full object-cover border-2 border-brand-200" />
              <span class="text-sm font-medium text-stone-700 hidden sm:block"><%= currentUser.username %></span>
              <i data-lucide="chevron-down" class="w-3.5 h-3.5 text-stone-400"></i>
            </button>

            <!-- Dropdown -->
            <div class="absolute right-0 top-full mt-2 w-52 bg-white border border-stone-100 rounded-xl shadow-lg py-1.5
                        opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 z-50">

              <!-- User info -->
              <div class="px-4 py-2 border-b border-stone-100 mb-1">
                <p class="text-xs font-semibold text-stone-800"><%= currentUser.username %></p>
                <p class="text-xs text-stone-400 truncate"><%= currentUser.email %></p>
              </div>

              <a href="/profile/edit"
                 class="flex items-center gap-2 px-4 py-2 text-sm text-stone-700 hover:bg-stone-50 transition-colors">
                <i data-lucide="user-pen" class="w-4 h-4 text-brand-500"></i> Edit Profile
              </a>
              <a href="/orders/my-orders"
                 class="flex items-center gap-2 px-4 py-2 text-sm text-stone-700 hover:bg-stone-50 transition-colors">
                <i data-lucide="package" class="w-4 h-4 text-brand-500"></i> My Orders
              </a>
              <a href="/address"
                 class="flex items-center gap-2 px-4 py-2 text-sm text-stone-700 hover:bg-stone-50 transition-colors">
                <i data-lucide="map-pin" class="w-4 h-4 text-brand-500"></i> My Addresses
              </a>

              <% if (currentUser.role === 'admin') { %>
                <div class="border-t border-stone-100 my-1"></div>
                <a href="/admin"
                   class="flex items-center gap-2 px-4 py-2 text-sm text-stone-700 hover:bg-stone-50 transition-colors">
                  <i data-lucide="shield" class="w-4 h-4 text-purple-500"></i> Admin Dashboard
                </a>
                <a href="/admin/orders"
                   class="flex items-center gap-2 px-4 py-2 text-sm text-stone-700 hover:bg-stone-50 transition-colors">
                  <i data-lucide="package-check" class="w-4 h-4 text-purple-500"></i> Manage Orders
                </a>
              <% } %>

              <div class="border-t border-stone-100 my-1"></div>
              <form action="/auth/logout" method="POST">
                <button type="submit"
                        class="w-full text-left flex items-center gap-2 px-4 py-2 text-sm text-red-500 hover:bg-red-50 transition-colors">
                  <i data-lucide="log-out" class="w-4 h-4"></i> Sign Out
                </button>
              </form>
            </div>
          </div>

        <% } else { %>
          <a href="/auth/login"
             class="text-sm font-medium text-stone-600 hover:text-brand-600 transition-colors px-3 py-2">
            Sign In
          </a>
          <a href="/auth/register"
             class="text-sm font-medium bg-brand-500 hover:bg-brand-600 text-white px-4 py-2 rounded-lg transition-colors shadow-sm">
            Get Started
          </a>
        <% } %>

        <!-- Mobile menu button -->
        <button id="mobile-menu-btn" class="md:hidden p-2 rounded-lg hover:bg-stone-100 transition-colors">
          <i data-lucide="menu" class="w-5 h-5 text-stone-600"></i>
        </button>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="hidden md:hidden pb-4 border-t border-stone-100 pt-3 space-y-1">
      <a href="/products"           class="block px-3 py-2 text-sm text-stone-700 hover:bg-stone-50 rounded-lg">Browse All</a>
      <a href="/products?type=rent" class="block px-3 py-2 text-sm text-stone-700 hover:bg-stone-50 rounded-lg">Rent</a>
      <a href="/products?type=buy"  class="block px-3 py-2 text-sm text-stone-700 hover:bg-stone-50 rounded-lg">Buy</a>
      <a href="/products?type=sell" class="block px-3 py-2 text-sm text-stone-700 hover:bg-stone-50 rounded-lg">Sell</a>
      <% if (currentUser) { %>
        <div class="border-t border-stone-100 pt-2 mt-2 space-y-1">
          <a href="/products/new"     class="block px-3 py-2 text-sm text-brand-600 font-medium hover:bg-brand-50 rounded-lg">+ List an Item</a>
          <a href="/profile/edit"     class="block px-3 py-2 text-sm text-stone-700 hover:bg-stone-50 rounded-lg">👤 Edit Profile</a>
          <a href="/orders/my-orders" class="block px-3 py-2 text-sm text-stone-700 hover:bg-stone-50 rounded-lg">📦 My Orders</a>
          <a href="/address"          class="block px-3 py-2 text-sm text-stone-700 hover:bg-stone-50 rounded-lg">🏠 My Addresses</a>
          <% if (currentUser.role === 'admin') { %>
            <a href="/admin"        class="block px-3 py-2 text-sm text-stone-700 hover:bg-stone-50 rounded-lg">🛡️ Admin Panel</a>
            <a href="/admin/orders" class="block px-3 py-2 text-sm text-stone-700 hover:bg-stone-50 rounded-lg">📋 Manage Orders</a>
          <% } %>
        </div>
      <% } %>
    </div>

  </div>
</nav>
