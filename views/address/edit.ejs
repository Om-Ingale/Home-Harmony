<%- layout('boilerplate') %>

<div class="max-w-xl mx-auto px-4 sm:px-6 py-10">
  <div class="mb-8">
    <a href="/address"
       class="inline-flex items-center gap-1.5 text-sm text-stone-500
              hover:text-brand-500 transition-colors mb-4">
      <i data-lucide="arrow-left" class="w-4 h-4"></i> Back to Addresses
    </a>
    <h1 class="font-display text-3xl font-bold text-stone-900">Edit Address</h1>
    <p class="text-stone-500 mt-1 text-sm">Update your delivery details</p>
  </div>

  <form action="/address/<%= address._id %>?_method=PUT" method="POST"
        class="bg-white rounded-2xl border border-stone-100 shadow-sm p-8 space-y-5">

    <!-- Label -->
    <div>
      <label class="block text-sm font-medium text-stone-700 mb-2">Address Type</label>
      <div class="flex gap-3">
        <% ['Home','Work','Other'].forEach(l => { %>
          <label class="flex-1 cursor-pointer">
            <input type="radio" name="label" value="<%= l %>"
                   class="hidden peer" <%= address.label === l ? 'checked' : '' %> />
            <div class="peer-checked:border-brand-500 peer-checked:bg-brand-50
                        peer-checked:text-brand-700 border-2 border-stone-200
                        rounded-xl py-2 text-center text-sm font-medium
                        text-stone-600 transition-all">
              <%= l === 'Home' ? '🏠' : l === 'Work' ? '💼' : '📍' %> <%= l %>
            </div>
          </label>
        <% }) %>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-medium text-stone-700 mb-1.5">Full Name *</label>
        <input type="text" name="fullName" required value="<%= address.fullName %>"
               class="w-full border border-stone-200 rounded-xl px-4 py-2.5 text-sm
                      focus:outline-none focus:ring-2 focus:ring-brand-300" />
      </div>
      <div>
        <label class="block text-sm font-medium text-stone-700 mb-1.5">Phone *</label>
        <input type="tel" name="phone" required value="<%= address.phone %>" maxlength="10"
               class="w-full border border-stone-200 rounded-xl px-4 py-2.5 text-sm
                      focus:outline-none focus:ring-2 focus:ring-brand-300" />
      </div>
    </div>

    <div>
      <label class="block text-sm font-medium text-stone-700 mb-1.5">House / Flat / Building *</label>
      <input type="text" name="line1" required value="<%= address.line1 %>"
             class="w-full border border-stone-200 rounded-xl px-4 py-2.5 text-sm
                    focus:outline-none focus:ring-2 focus:ring-brand-300" />
    </div>

    <div>
      <label class="block text-sm font-medium text-stone-700 mb-1.5">
        Street / Area <span class="text-stone-400 font-normal">(optional)</span>
      </label>
      <input type="text" name="line2" value="<%= address.line2 || '' %>"
             class="w-full border border-stone-200 rounded-xl px-4 py-2.5 text-sm
                    focus:outline-none focus:ring-2 focus:ring-brand-300" />
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-medium text-stone-700 mb-1.5">City *</label>
        <input type="text" name="city" required value="<%= address.city %>"
               class="w-full border border-stone-200 rounded-xl px-4 py-2.5 text-sm
                      focus:outline-none focus:ring-2 focus:ring-brand-300" />
      </div>
      <div>
        <label class="block text-sm font-medium text-stone-700 mb-1.5">State *</label>
        <select name="state" required
                class="w-full border border-stone-200 rounded-xl px-4 py-2.5 text-sm
                       focus:outline-none focus:ring-2 focus:ring-brand-300 bg-white">
          <% ['Andhra Pradesh','Arunachal Pradesh','Assam','Bihar','Chhattisgarh',
              'Goa','Gujarat','Haryana','Himachal Pradesh','Jharkhand','Karnataka',
              'Kerala','Madhya Pradesh','Maharashtra','Manipur','Meghalaya','Mizoram',
              'Nagaland','Odisha','Punjab','Rajasthan','Sikkim','Tamil Nadu','Telangana',
              'Tripura','Uttar Pradesh','Uttarakhand','West Bengal',
              'Delhi','Jammu & Kashmir','Ladakh'].forEach(s => { %>
            <option value="<%= s %>" <%= address.state === s ? 'selected' : '' %>><%= s %></option>
          <% }) %>
        </select>
      </div>
    </div>

    <div>
      <label class="block text-sm font-medium text-stone-700 mb-1.5">Pincode *</label>
      <input type="text" name="pincode" required value="<%= address.pincode %>"
             maxlength="6" pattern="\d{6}"
             class="w-full border border-stone-200 rounded-xl px-4 py-2.5 text-sm
                    focus:outline-none focus:ring-2 focus:ring-brand-300" />
    </div>

    <label class="flex items-center gap-3 cursor-pointer">
      <input type="checkbox" name="isDefault" <%= address.isDefault ? 'checked' : '' %>
             class="w-4 h-4 rounded accent-orange-500" />
      <span class="text-sm text-stone-700">Set as default address</span>
    </label>

    <div class="flex gap-3 pt-2">
      <button type="submit"
              class="flex-1 bg-brand-500 hover:bg-brand-600 text-white font-semibold
                     py-3 rounded-xl transition-colors shadow-sm text-sm">
        Save Changes
      </button>
      <a href="/address"
         class="px-6 py-3 border border-stone-200 text-stone-600 rounded-xl
                hover:bg-stone-50 transition-colors text-sm font-medium flex items-center">
        Cancel
      </a>
    </div>
  </form>
</div>