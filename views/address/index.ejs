<%- layout('boilerplate') %>

<div class="max-w-3xl mx-auto px-4 sm:px-6 py-10">

  <!-- Header -->
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="font-display text-3xl font-bold text-stone-900">My Addresses</h1>
      <p class="text-stone-500 mt-1 text-sm">Manage your saved delivery addresses</p>
    </div>
    <button onclick="showAddForm()"
            class="flex items-center gap-2 bg-brand-500 hover:bg-brand-600 text-white
                   font-semibold px-5 py-2.5 rounded-xl transition-colors shadow-sm text-sm">
      <i data-lucide="plus" class="w-4 h-4"></i> Add Address
    </button>
  </div>

  <!-- Address Cards -->
  <% if (addresses.length === 0) { %>
    <div class="text-center py-16 bg-white rounded-2xl border border-stone-100 shadow-sm">
      <div class="w-16 h-16 bg-stone-100 rounded-full flex items-center justify-center mx-auto mb-4">
        <i data-lucide="map-pin" class="w-7 h-7 text-stone-400"></i>
      </div>
      <h3 class="font-semibold text-stone-700 mb-2">No addresses yet</h3>
      <p class="text-stone-400 text-sm mb-6">Add a delivery address to get started</p>
      <button onclick="showAddForm()"
              class="bg-brand-500 hover:bg-brand-600 text-white font-semibold
                     px-6 py-2.5 rounded-xl transition-colors text-sm">
        + Add Your First Address
      </button>
    </div>
  <% } else { %>
    <div class="space-y-4" id="address-list">
      <% addresses.forEach(addr => { %>
        <div class="bg-white rounded-2xl border-2 <%= addr.isDefault ? 'border-brand-400' : 'border-stone-100' %>
                    shadow-sm p-5 transition-all hover:shadow-md">
          <div class="flex items-start justify-between">
            <div class="flex items-start gap-3">

              <!-- Label icon -->
              <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0
                          <%= addr.label === 'Home' ? 'bg-blue-50' : addr.label === 'Work' ? 'bg-purple-50' : 'bg-amber-50' %>">
                <% if (addr.label === 'Home') { %>
                  <i data-lucide="home" class="w-5 h-5 text-blue-500"></i>
                <% } else if (addr.label === 'Work') { %>
                  <i data-lucide="briefcase" class="w-5 h-5 text-purple-500"></i>
                <% } else { %>
                  <i data-lucide="map-pin" class="w-5 h-5 text-amber-500"></i>
                <% } %>
              </div>

              <!-- Address details -->
              <div>
                <div class="flex items-center gap-2 mb-1">
                  <span class="font-semibold text-stone-800 text-sm"><%= addr.label %></span>
                  <% if (addr.isDefault) { %>
                    <span class="text-xs bg-brand-100 text-brand-700 px-2 py-0.5 rounded-full font-medium">
                      Default
                    </span>
                  <% } %>
                </div>
                <p class="text-stone-700 text-sm font-medium"><%= addr.fullName %></p>
                <p class="text-stone-500 text-sm mt-0.5">
                  <%= addr.line1 %><% if (addr.line2) { %>, <%= addr.line2 %><% } %>
                </p>
                <p class="text-stone-500 text-sm">
                  <%= addr.city %>, <%= addr.state %> — <%= addr.pincode %>
                </p>
                <p class="text-stone-400 text-sm mt-0.5">📞 <%= addr.phone %></p>
              </div>
            </div>

            <!-- Actions -->
            <div class="flex flex-col gap-2 shrink-0">
              <a href="/address/<%= addr._id %>/edit"
                 class="text-xs text-stone-500 hover:text-brand-600 border border-stone-200
                        hover:border-brand-300 px-3 py-1.5 rounded-lg transition-colors text-center">
                Edit
              </a>
              <% if (!addr.isDefault) { %>
                <form action="/address/<%= addr._id %>/set-default?_method=POST" method="POST">
                  <button type="submit"
                          class="w-full text-xs text-brand-600 hover:text-brand-700 border
                                 border-brand-200 hover:border-brand-400 px-3 py-1.5
                                 rounded-lg transition-colors">
                    Set Default
                  </button>
                </form>
              <% } %>
              <form action="/address/<%= addr._id %>?_method=DELETE" method="POST"
                    onsubmit="return confirm('Remove this address?')">
                <button type="submit"
                        class="w-full text-xs text-red-400 hover:text-red-600 border
                               border-red-100 hover:border-red-300 px-3 py-1.5
                               rounded-lg transition-colors">
                  Remove
                </button>
              </form>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<!-- ── Add Address Slide-in Panel ─────────────────────────────────────────── -->
<div id="add-address-overlay"
     style="display:none; position:fixed; inset:0; z-index:99999;
            background:rgba(0,0,0,0.5); backdrop-filter:blur(4px);">
  <div id="add-address-panel"
       style="position:fixed; right:0; top:0; height:100%; width:100%;
              max-width:480px; background:#fff; overflow-y:auto;
              box-shadow:-8px 0 40px rgba(0,0,0,0.15);
              transform:translateX(100%); transition:transform 0.3s ease;">

    <div style="padding:28px;">
      <!-- Panel header -->
      <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:24px;">
        <div>
          <h2 style="font-size:18px; font-weight:700; color:#1c1917; margin:0;">Add New Address</h2>
          <p style="font-size:13px; color:#78716c; margin:4px 0 0;">Fill in your delivery details</p>
        </div>
        <button onclick="hideAddForm()"
                style="width:32px; height:32px; border-radius:50%; background:#f5f5f4;
                       border:none; cursor:pointer; display:flex; align-items:center; justify-content:center;">
          <svg viewBox="0 0 24 24" fill="none" stroke="#78716c" stroke-width="2.5"
               style="width:14px; height:14px;"><path d="M18 6L6 18M6 6l12 12"/></svg>
        </button>
      </div>

      <!-- Form -->
      <form action="/address" method="POST" class="space-y-4">

        <!-- Label -->
        <div>
          <label class="block text-sm font-medium text-stone-700 mb-2">Address Type</label>
          <div class="flex gap-3">
            <% ['Home','Work','Other'].forEach(l => { %>
              <label class="flex-1 cursor-pointer">
                <input type="radio" name="label" value="<%= l %>"
                       class="hidden peer" <%= l === 'Home' ? 'checked' : '' %> />
                <div class="peer-checked:border-brand-500 peer-checked:bg-brand-50
                            peer-checked:text-brand-700 border-2 border-stone-200
                            rounded-xl py-2 text-center text-sm font-medium
                            text-stone-600 transition-all">
                  <%= l === 'Home' ? '🏠' : l === 'Work' ? '💼' : '📍' %> <%= l %>
                </div>
              </label>
            <% }) %>
          </div>
        </div>

        <!-- Full Name + Phone -->
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium text-stone-700 mb-1.5">Full Name *</label>
            <input type="text" name="fullName" required placeholder="Rahul Sharma"
                   class="w-full border border-stone-200 rounded-xl px-4 py-2.5 text-sm
                          focus:outline-none focus:ring-2 focus:ring-brand-300" />
          </div>
          <div>
            <label class="block text-sm font-medium text-stone-700 mb-1.5">Phone *</label>
            <input type="tel" name="phone" required placeholder="9876543210" maxlength="10"
                   class="w-full border border-stone-200 rounded-xl px-4 py-2.5 text-sm
                          focus:outline-none focus:ring-2 focus:ring-brand-300" />
          </div>
        </div>

        <!-- Line 1 -->
        <div>
          <label class="block text-sm font-medium text-stone-700 mb-1.5">
            House / Flat / Building *
          </label>
          <input type="text" name="line1" required placeholder="Flat 4B, Sunrise Apartments"
                 class="w-full border border-stone-200 rounded-xl px-4 py-2.5 text-sm
                        focus:outline-none focus:ring-2 focus:ring-brand-300" />
        </div>

        <!-- Line 2 -->
        <div>
          <label class="block text-sm font-medium text-stone-700 mb-1.5">
            Street / Area <span class="text-stone-400 font-normal">(optional)</span>
          </label>
          <input type="text" name="line2" placeholder="MG Road, Koregaon Park"
                 class="w-full border border-stone-200 rounded-xl px-4 py-2.5 text-sm
                        focus:outline-none focus:ring-2 focus:ring-brand-300" />
        </div>

        <!-- City + State -->
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium text-stone-700 mb-1.5">City *</label>
            <input type="text" name="city" required placeholder="Pune"
                   class="w-full border border-stone-200 rounded-xl px-4 py-2.5 text-sm
                          focus:outline-none focus:ring-2 focus:ring-brand-300" />
          </div>
          <div>
            <label class="block text-sm font-medium text-stone-700 mb-1.5">State *</label>
            <select name="state" required
                    class="w-full border border-stone-200 rounded-xl px-4 py-2.5 text-sm
                           focus:outline-none focus:ring-2 focus:ring-brand-300 bg-white">
              <option value="" disabled selected>Select state</option>
              <% ['Andhra Pradesh','Arunachal Pradesh','Assam','Bihar','Chhattisgarh',
                  'Goa','Gujarat','Haryana','Himachal Pradesh','Jharkhand','Karnataka',
                  'Kerala','Madhya Pradesh','Maharashtra','Manipur','Meghalaya','Mizoram',
                  'Nagaland','Odisha','Punjab','Rajasthan','Sikkim','Tamil Nadu','Telangana',
                  'Tripura','Uttar Pradesh','Uttarakhand','West Bengal',
                  'Delhi','Jammu & Kashmir','Ladakh'].forEach(s => { %>
                <option value="<%= s %>"><%= s %></option>
              <% }) %>
            </select>
          </div>
        </div>

        <!-- Pincode -->
        <div>
          <label class="block text-sm font-medium text-stone-700 mb-1.5">Pincode *</label>
          <input type="text" name="pincode" required placeholder="411001" maxlength="6"
                 pattern="\d{6}"
                 class="w-full border border-stone-200 rounded-xl px-4 py-2.5 text-sm
                        focus:outline-none focus:ring-2 focus:ring-brand-300" />
        </div>

        <!-- Default checkbox -->
        <label class="flex items-center gap-3 cursor-pointer">
          <input type="checkbox" name="isDefault"
                 class="w-4 h-4 rounded border-stone-300 text-brand-500
                        focus:ring-brand-300 accent-orange-500" />
          <span class="text-sm text-stone-700">Set as default address</span>
        </label>

        <!-- Submit -->
        <button type="submit"
                class="w-full bg-brand-500 hover:bg-brand-600 text-white font-semibold
                       py-3 rounded-xl transition-colors shadow-sm text-sm mt-2">
          Save Address
        </button>
      </form>
    </div>
  </div>
</div>

<script>
  function showAddForm() {
    const overlay = document.getElementById('add-address-overlay');
    const panel   = document.getElementById('add-address-panel');
    overlay.style.display = 'block';
    document.body.style.overflow = 'hidden';
    setTimeout(() => { panel.style.transform = 'translateX(0)'; }, 10);
  }

  function hideAddForm() {
    const panel   = document.getElementById('add-address-panel');
    const overlay = document.getElementById('add-address-overlay');
    panel.style.transform = 'translateX(100%)';
    setTimeout(() => {
      overlay.style.display = 'none';
      document.body.style.overflow = '';
    }, 300);
  }

  // Close on backdrop click
  document.getElementById('add-address-overlay').addEventListener('click', function(e) {
    if (e.target === this) hideAddForm();
  });
</script>