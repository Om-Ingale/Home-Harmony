<%- layout('boilerplate') %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <div class="flex items-center gap-4 mb-8">
    <a href="/admin" class="text-stone-400 hover:text-brand-500 transition-colors">
      <i data-lucide="arrow-left" class="w-5 h-5"></i>
    </a>
    <h1 class="font-display text-3xl font-bold text-stone-900">Manage Listings</h1>
    <span class="ml-auto text-sm text-stone-500"><%= products.length %> listings</span>
  </div>

  <div class="bg-white rounded-2xl border border-stone-100 shadow-sm overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-stone-50 border-b border-stone-100">
        <tr>
          <th class="text-left px-6 py-3.5 font-medium text-stone-500">Listing</th>
          <th class="text-left px-6 py-3.5 font-medium text-stone-500 hidden md:table-cell">Owner</th>
          <th class="text-left px-6 py-3.5 font-medium text-stone-500">Type</th>
          <th class="text-left px-6 py-3.5 font-medium text-stone-500 hidden md:table-cell">Status</th>
          <th class="text-right px-6 py-3.5 font-medium text-stone-500">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-stone-50">
        <% products.forEach(p => { %>
          <tr class="hover:bg-stone-50 transition-colors">
            <td class="px-6 py-4">
              <div class="flex items-center gap-3">
                <img src="<%= p.images[0]?.url || 'https://placehold.co/48?text=HH' %>"
                     class="w-12 h-10 rounded-lg object-cover border border-stone-100" />
                <div>
                  <p class="font-medium text-stone-800 truncate max-w-[180px]"><%= p.title %></p>
                  <p class="text-xs text-stone-400"><%= p.city %> · ₹<%= p.price.toLocaleString('en-IN') %></p>
                </div>
              </div>
            </td>
            <td class="px-6 py-4 text-stone-500 hidden md:table-cell"><%= p.owner?.username || 'N/A' %></td>
            <td class="px-6 py-4">
              <span class="text-xs px-2.5 py-1 rounded-full capitalize font-medium
                <%= p.type === 'rent' ? 'bg-blue-100 text-blue-700' : p.type === 'buy' ? 'bg-emerald-100 text-emerald-700' : 'bg-amber-100 text-amber-700' %>">
                <%= p.type %>
              </span>
            </td>
            <td class="px-6 py-4 hidden md:table-cell">
              <span class="text-xs px-2.5 py-1 rounded-full capitalize
                <%= p.status === 'available' ? 'bg-emerald-100 text-emerald-700' : 'bg-red-100 text-red-700' %>">
                <%= p.status %>
              </span>
            </td>
            <td class="px-6 py-4">
              <div class="flex items-center justify-end gap-2">
                <a href="/products/<%= p._id %>"
                   class="text-stone-400 hover:text-brand-500 transition-colors p-1.5">
                  <i data-lucide="external-link" class="w-4 h-4"></i>
                </a>
                <form action="/admin/products/<%= p._id %>?_method=DELETE" method="POST"
                      onsubmit="return confirm('Delete this listing and all its images?')">
                  <button type="submit"
                          class="text-xs px-3 py-1.5 bg-red-50 border border-red-200 text-red-600 rounded-lg hover:bg-red-100 transition-colors">
                    Delete
                  </button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>