<%- layout('boilerplate') %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="font-display text-3xl font-bold text-stone-900">Admin Dashboard</h1>
      <p class="text-stone-500 mt-1">Welcome back, <%= currentUser.username %></p>
    </div>
    <span class="bg-brand-100 text-brand-700 text-xs font-semibold px-3 py-1.5 rounded-full">Admin</span>
  </div>

  <!-- Stat Cards -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10">
    <% const cards = [
      { label: 'Total Users',    val: stats.userCount,    icon: 'users',      color: 'bg-blue-50 border-blue-200 text-blue-600'   },
      { label: 'Total Listings', val: stats.productCount, icon: 'package',    color: 'bg-amber-50 border-amber-200 text-amber-600'  },
      { label: 'Total Reviews',  val: stats.reviewCount,  icon: 'star',       color: 'bg-violet-50 border-violet-200 text-violet-600' },
      { label: 'Available',      val: stats.availableCount,icon:'check-circle',color:'bg-emerald-50 border-emerald-200 text-emerald-600'},
    ]; %>
    <% cards.forEach(c => { %>
      <div class="<%= c.color %> rounded-2xl border-2 shadow-md p-6 hover:shadow-lg transition-shadow group">
        <div class="flex items-center justify-between mb-4">
          <span class="text-sm font-semibold text-stone-700"><%= c.label %></span>
          <span class="<%= c.color.split(' ')[0] %> p-3 rounded-xl">
            <i data-lucide="<%= c.icon %>" class="w-5 h-5"></i>
          </span>
        </div>
        <p class="font-display text-4xl font-bold text-stone-900"><%= c.val %></p>
      </div>
    <% }) %>
  </div>

  <!-- Type breakdown -->
  <div class="grid grid-cols-3 gap-4 mb-10">
    <div class="bg-blue-50 border border-blue-100 rounded-2xl p-5 text-center">
      <p class="text-3xl font-display font-bold text-blue-700"><%= stats.rentCount %></p>
      <p class="text-sm text-blue-600 mt-1">For Rent</p>
    </div>
    <div class="bg-emerald-50 border border-emerald-100 rounded-2xl p-5 text-center">
      <p class="text-3xl font-display font-bold text-emerald-700"><%= stats.buyCount %></p>
      <p class="text-sm text-emerald-600 mt-1">For Buy</p>
    </div>
    <div class="bg-amber-50 border border-amber-100 rounded-2xl p-5 text-center">
      <p class="text-3xl font-display font-bold text-amber-700"><%= stats.sellCount %></p>
      <p class="text-sm text-amber-600 mt-1">For Sale</p>
    </div>
  </div>

  <!-- Quick Nav -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-10">
    <a href="/admin/users" class="flex items-center gap-4 bg-blue-50 border border-blue-100 rounded-2xl p-5 shadow-sm hover:shadow-md transition-all hover:-translate-y-0.5">
      <div class="bg-blue-100 p-3 rounded-xl"><i data-lucide="users" class="w-5 h-5 text-blue-600"></i></div>
      <div><p class="font-semibold text-stone-800">Manage Users</p><p class="text-xs text-stone-400">View, promote, delete</p></div>
    </a>
    <a href="/admin/products" class="flex items-center gap-4 bg-amber-50 border border-amber-100 rounded-2xl p-5 shadow-sm hover:shadow-md transition-all hover:-translate-y-0.5">
      <div class="bg-amber-100 p-3 rounded-xl"><i data-lucide="package" class="w-5 h-5 text-amber-600"></i></div>
      <div><p class="font-semibold text-stone-800">Manage Listings</p><p class="text-xs text-stone-400">View, remove listings</p></div>
    </a>
    <a href="/admin/reviews" class="flex items-center gap-4 bg-violet-50 border border-violet-100 rounded-2xl p-5 shadow-sm hover:shadow-md transition-all hover:-translate-y-0.5">
      <div class="bg-violet-100 p-3 rounded-xl"><i data-lucide="star" class="w-5 h-5 text-violet-600"></i></div>
      <div><p class="font-semibold text-stone-800">Manage Reviews</p><p class="text-xs text-stone-400">Moderate reviews</p></div>
    </a>
  </div>

  <!-- Recent Products -->
  <div class="bg-white rounded-2xl border border-stone-100 shadow-sm overflow-hidden">
    <div class="px-6 py-4 border-b border-stone-100">
      <h2 class="font-semibold text-stone-800">Recent Listings</h2>
    </div>
    <div class="divide-y divide-stone-50">
      <% recentProducts.forEach(p => { %>
        <div class="flex items-center justify-between px-6 py-4 hover:bg-stone-50 transition-colors">
          <div class="flex items-center gap-4">
            <img src="<%= p.images[0]?.url || 'https://placehold.co/48?text=HH' %>"
                 class="w-12 h-12 rounded-xl object-cover border border-stone-100" />
            <div>
              <p class="font-medium text-stone-800 text-sm"><%= p.title %></p>
              <p class="text-xs text-stone-400"><%= p.owner?.username %> · <%= p.city %></p>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-xs px-2.5 py-1 rounded-full capitalize
              <%= p.type === 'rent' ? 'bg-blue-100 text-blue-700' : p.type === 'buy' ? 'bg-emerald-100 text-emerald-700' : 'bg-amber-100 text-amber-700' %>">
              <%= p.type %>
            </span>
            <a href="/products/<%= p._id %>" class="text-stone-400 hover:text-brand-500 transition-colors">
              <i data-lucide="external-link" class="w-4 h-4"></i>
            </a>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</div>