<%- layout('boilerplate') %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <div class="flex items-center gap-4 mb-8">
    <a href="/admin" class="text-stone-400 hover:text-brand-500 transition-colors">
      <i data-lucide="arrow-left" class="w-5 h-5"></i>
    </a>
    <h1 class="font-display text-3xl font-bold text-stone-900">Manage Users</h1>
    <span class="ml-auto text-sm text-stone-500"><%= users.length %> users</span>
  </div>

  <div class="bg-white rounded-2xl border border-stone-100 shadow-sm overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-stone-50 border-b border-stone-100">
        <tr>
          <th class="text-left px-6 py-3.5 font-medium text-stone-500">User</th>
          <th class="text-left px-6 py-3.5 font-medium text-stone-500 hidden md:table-cell">Email</th>
          <th class="text-left px-6 py-3.5 font-medium text-stone-500">Role</th>
          <th class="text-left px-6 py-3.5 font-medium text-stone-500 hidden md:table-cell">Joined</th>
          <th class="text-right px-6 py-3.5 font-medium text-stone-500">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-stone-50">
        <% users.forEach(user => { %>
          <tr class="hover:bg-stone-50 transition-colors">
            <td class="px-6 py-4">
              <div class="flex items-center gap-3">
                <img src="<%= user.avatar.url %>" class="w-9 h-9 rounded-full object-cover border border-stone-100" />
                <span class="font-medium text-stone-800"><%= user.username %></span>
              </div>
            </td>
            <td class="px-6 py-4 text-stone-500 hidden md:table-cell"><%= user.email %></td>
            <td class="px-6 py-4">
              <span class="text-xs px-2.5 py-1 rounded-full font-medium
                <%= user.role === 'admin' ? 'bg-brand-100 text-brand-700' : 'bg-stone-100 text-stone-600' %>">
                <%= user.role %>
              </span>
            </td>
            <td class="px-6 py-4 text-stone-400 hidden md:table-cell">
              <%= new Date(user.createdAt).toLocaleDateString('en-IN') %>
            </td>
            <td class="px-6 py-4">
              <div class="flex items-center justify-end gap-2">
                <% if (!user._id.equals(currentUser._id)) { %>
                  <form action="/admin/users/<%= user._id %>/toggle-role?_method=POST" method="POST">
                    <button type="submit"
                            class="text-xs px-3 py-1.5 border border-stone-200 rounded-lg text-stone-600 hover:bg-stone-50 transition-colors">
                      <%= user.role === 'admin' ? 'Demote' : 'Promote' %>
                    </button>
                  </form>
                  <form action="/admin/users/<%= user._id %>?_method=DELETE" method="POST"
                        onsubmit="return confirm('Delete this user?')">
                    <button type="submit"
                            class="text-xs px-3 py-1.5 bg-red-50 border border-red-200 text-red-600 rounded-lg hover:bg-red-100 transition-colors">
                      Delete
                    </button>
                  </form>
                <% } else { %>
                  <span class="text-xs text-stone-400 italic">You</span>
                <% } %>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>