<%- layout('boilerplate') %>

<div class="min-h-[70vh] flex items-center justify-center px-4">
  <div class="text-center max-w-md">
    <p class="text-8xl font-display font-bold text-stone-200 mb-2"><%= statusCode || 500 %></p>
    <h1 class="text-2xl font-semibold text-stone-800 mb-3">
      <%= statusCode === 404 ? 'Page not found' : 'Something went wrong' %>
    </h1>
    <p class="text-stone-500 text-sm mb-8"><%= message || 'An unexpected error occurred.' %></p>
    <a href="/"
       class="inline-flex items-center gap-2 bg-brand-500 hover:bg-brand-600 text-white px-6 py-2.5 rounded-xl font-medium text-sm transition-colors">
      <i data-lucide="home" class="w-4 h-4"></i> Back to Home
    </a>
  </div>
</div>