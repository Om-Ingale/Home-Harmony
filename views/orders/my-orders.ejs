<%- layout('boilerplate') %>

<div class="max-w-4xl mx-auto px-4 sm:px-6 py-10">
  <div class="mb-8">
    <h1 class="font-display text-3xl font-bold text-stone-900">My Orders</h1>
    <p class="text-stone-500 mt-1 text-sm">Track and manage all your orders</p>
  </div>

  <% if (orders.length === 0) { %>
    <div class="text-center py-20 bg-white rounded-2xl border border-stone-100 shadow-sm">
      <div class="w-16 h-16 bg-stone-100 rounded-full flex items-center justify-center mx-auto mb-4">
        <i data-lucide="package" class="w-7 h-7 text-stone-400"></i>
      </div>
      <h3 class="font-semibold text-stone-700 mb-2">No orders yet</h3>
      <p class="text-stone-400 text-sm mb-6">Browse listings and place your first order</p>
      <a href="/products"
         class="bg-brand-500 hover:bg-brand-600 text-white font-semibold px-6 py-2.5 rounded-xl transition-colors text-sm">
        Browse Listings
      </a>
    </div>
  <% } else { %>
    <div class="space-y-4">
      <% orders.forEach(order => { %>
        <% if (!order.product) { %>
          <!-- Deleted product fallback -->
          <div class="bg-white rounded-2xl border border-stone-100 shadow-sm p-5 opacity-60">
            <p class="text-sm text-stone-500">Order #<%= order._id.toString().slice(-8).toUpperCase() %> — Product no longer available</p>
          </div>
        <% } else { %>
        <div class="bg-white rounded-2xl border border-stone-100 shadow-sm p-5 hover:shadow-md transition-shadow">
          <div class="flex items-start gap-4">

            <!-- Product image -->
            <img src="<%= order.product.images?.[0]?.url || 'https://placehold.co/80x80?text=No+Image' %>"
                 alt="<%= order.product.title %>"
                 class="w-20 h-20 object-cover rounded-xl border border-stone-200 shrink-0" />

            <!-- Order info -->
            <div class="flex-1 min-w-0">
              <div class="flex items-start justify-between gap-2 flex-wrap">
                <div>
                  <p class="font-semibold text-stone-900 truncate"><%= order.product.title %></p>
                  <p class="text-stone-400 text-xs mt-0.5">
                    Order #<%= order._id.toString().slice(-8).toUpperCase() %>
                    · <%= new Date(order.createdAt).toLocaleDateString('en-IN', {day:'numeric',month:'short',year:'numeric'}) %>
                  </p>
                </div>
                <%
                  const statusStyle = {
                    pending:    'bg-amber-100 text-amber-700',
                    confirmed:  'bg-blue-100 text-blue-700',
                    in_transit: 'bg-purple-100 text-purple-700',
                    delivered:  'bg-emerald-100 text-emerald-700',
                    cancelled:  'bg-red-100 text-red-700',
                  };
                  const statusLabel = {
                    pending:    '⏳ Pending',
                    confirmed:  '✅ Confirmed',
                    in_transit: '🚚 In Transit',
                    delivered:  '📦 Delivered',
                    cancelled:  '❌ Cancelled',
                  };
                %>
                <span class="text-xs font-semibold px-2.5 py-1 rounded-full <%= statusStyle[order.status] || 'bg-stone-100 text-stone-600' %>">
                  <%= statusLabel[order.status] || order.status %>
                </span>
              </div>

              <div class="flex flex-wrap items-center gap-3 mt-3">
                <span class="text-sm font-bold text-stone-900">
                  ₹<%= order.totalAmount.toLocaleString('en-IN') %>
                </span>
                <span class="text-xs px-2 py-0.5 rounded-full capitalize
                             <%= order.type === 'rent' ? 'bg-blue-50 text-blue-600' : 'bg-emerald-50 text-emerald-600' %>">
                  <%= order.type %>
                </span>
                <% if (order.type === 'rent' && order.totalDays) { %>
                  <span class="text-xs text-stone-400"><%= order.totalDays %> days</span>
                <% } %>
              </div>

              <!-- Mini tracking bar -->
              <% if (order.status !== 'cancelled' && order.status !== 'pending') {
                const steps   = ['confirmed','in_transit','delivered'];
                const stepIdx = steps.indexOf(order.status);
              %>
                <div class="flex items-center gap-1 mt-3">
                  <% steps.forEach((s, i) => { %>
                    <div class="h-1 flex-1 rounded-full transition-all <%= i <= stepIdx ? 'bg-brand-500' : 'bg-stone-200' %>"></div>
                  <% }) %>
                </div>
                <p class="text-xs text-stone-400 mt-1">
                  <%= ['Order Confirmed','In Transit','Delivered'][Math.max(0,stepIdx)] %>
                </p>
              <% } %>
            </div>
          </div>

          <!-- Action buttons -->
          <div class="flex gap-2 mt-4 pt-4 border-t border-stone-100 flex-wrap">
            <a href="/orders/<%= order._id %>"
               class="text-xs font-medium text-brand-600 hover:text-brand-700 border border-brand-200 hover:border-brand-400 px-3 py-1.5 rounded-lg transition-colors">
              View Details
            </a>
            <a href="/orders/<%= order._id %>/receipt"
               class="text-xs font-medium text-stone-600 hover:text-stone-800 border border-stone-200 hover:border-stone-400 px-3 py-1.5 rounded-lg transition-colors flex items-center gap-1"
               download>
              <i data-lucide="download" class="w-3 h-3"></i> Receipt
            </a>
            <% if (order.status !== 'delivered' && order.status !== 'cancelled') { %>
              <form action="/orders/<%= order._id %>/cancel?_method=PATCH" method="POST" class="order-cancel-form">
                <button type="button"
                        onclick="showOrderConfirmModal(this)"
                        data-action="cancel"
                        class="text-xs font-medium text-red-500 hover:text-red-700 border border-red-200 hover:border-red-400 px-3 py-1.5 rounded-lg transition-colors">
                  Cancel Order
                </button>
              </form>
            <% } %>
          </div>
        </div>
        <% } %>
      <% }) %>
    </div>
  <% } %>
</div>

<!-- ── Order Confirmation Modal ───────────────────────────────────────────────── -->
<div id="order-confirm-modal"
     style="display:none; position:fixed; top:0; left:0; width:100%; height:100%;
            z-index:999998; background:rgba(0,0,0,0.6); backdrop-filter:blur(4px);">
  <div style="display:flex; align-items:center; justify-content:center; width:100%; height:100%; padding:16px; box-sizing:border-box;">
    <div style="background:#fff; border-radius:16px; padding:28px; max-width:380px; width:100%;
                box-shadow:0 25px 60px rgba(0,0,0,0.3); text-align:center; box-sizing:border-box;">
      <div style="width:52px; height:52px; background:#fef2f2; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 16px;">
        <svg viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2" style="width:24px;height:24px;">
          <path d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
        </svg>
      </div>
      <h3 style="font-size:17px; font-weight:700; color:#1c1917; margin:0 0 8px;" id="modal-title">Cancel this order?</h3>
      <p style="font-size:13px; color:#78716c; margin:0 0 24px; line-height:1.6;" id="modal-body">
        This action cannot be undone. Any stock will be restored.
      </p>
      <div style="display:flex; gap:10px;">
        <button onclick="closeOrderConfirmModal()"
                style="flex:1; padding:11px; border-radius:12px; border:1.5px solid #e7e5e4; background:#fff; font-size:14px; font-weight:500; color:#78716c; cursor:pointer;"
                onmouseover="this.style.background='#f5f5f4'" onmouseout="this.style.background='#fff'">
          Go Back
        </button>
        <button id="modal-confirm-btn"
                style="flex:1; padding:11px; border-radius:12px; border:none; background:#ef4444; font-size:14px; font-weight:600; color:#fff; cursor:pointer;"
                onmouseover="this.style.background='#dc2626'" onmouseout="this.style.background='#ef4444'">
          Confirm
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  let _pendingOrderForm = null;
  let _formSubmitted    = false;

  function showOrderConfirmModal(btn) {
    _pendingOrderForm = btn.closest('form');
    document.getElementById('order-confirm-modal').style.display = 'flex';
    document.body.style.overflow = 'hidden';
  }

  function closeOrderConfirmModal() {
    document.getElementById('order-confirm-modal').style.display = 'none';
    document.body.style.overflow = '';
    _pendingOrderForm = null;
  }

  document.getElementById('modal-confirm-btn').addEventListener('click', function () {
    if (_formSubmitted || !_pendingOrderForm) return;
    _formSubmitted = true;
    this.disabled    = true;
    this.textContent = 'Processing...';
    _pendingOrderForm.submit();
  });

  document.getElementById('order-confirm-modal').addEventListener('click', function (e) {
    if (e.target === this) closeOrderConfirmModal();
  });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeOrderConfirmModal(); });
</script>
