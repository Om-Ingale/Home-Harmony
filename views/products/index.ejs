<%- layout('boilerplate') %>

<div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8 py-2">

  <!-- Header + Search -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
    <div>
      <h1 class="font-display text-3xl font-bold text-stone-900">Browse Listings</h1>
      <p class="text-stone-500 mt-1"><%= totalProducts %> item<%= totalProducts !== 1 ? 's' : '' %> found</p>
    </div>
    <div class="flex gap-2 items-center">
      <form action="/products" method="GET" class="flex gap-2">
        <% /* preserve existing filters in search */ %>
        <% if (filters.type)     { %><input type="hidden" name="type"     value="<%= filters.type %>"><% } %>
        <% if (filters.category) { %><input type="hidden" name="category" value="<%= filters.category %>"><% } %>
        <% if (filters.city)     { %><input type="hidden" name="city"     value="<%= filters.city %>"><% } %>
        <input type="text" name="search" value="<%= filters.search || '' %>"
               placeholder="Search listings..."
               class="border border-stone-200 rounded-xl px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-300 w-48 bg-white" />
        <button type="submit"
                class="bg-brand-500 hover:bg-brand-600 text-white px-4 py-2 rounded-xl text-sm font-medium transition-colors">
          <i data-lucide="search" class="w-4 h-4"></i>
        </button>
      </form>
      <!-- Mobile filter toggle -->
      <button id="filter-toggle"
              class="lg:hidden flex items-center gap-1.5 border border-stone-200 bg-white text-stone-700 px-4 py-2 rounded-xl text-sm font-medium">
        <i data-lucide="sliders-horizontal" class="w-4 h-4"></i> Filters
        <% if (activeFilters.length > 0) { %>
          <span class="bg-brand-500 text-white rounded-full text-xs w-5 h-5 flex items-center justify-center"><%= activeFilters.length %></span>
        <% } %>
      </button>
    </div>
  </div>

  <!-- Active Filter Tags -->
  <% if (activeFilters.length > 0) { %>
    <div class="flex flex-wrap gap-2 mb-4">
      <% activeFilters.forEach(f => { %>
        <span class="inline-flex items-center gap-1.5 bg-brand-50 border border-brand-200 text-brand-700 text-xs font-medium px-3 py-1 rounded-full capitalize">
          <%= f.label %>
          <a href="?<%= Object.entries(filters).filter(([k]) => k !== f.key).map(([k,v]) => `${k}=${encodeURIComponent(v)}`).join('&') %>"
             class="hover:text-brand-900 transition-colors">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="w-3 h-3"><path d="M18 6L6 18M6 6l12 12"/></svg>
          </a>
        </span>
      <% }) %>
      <a href="/products" class="inline-flex items-center gap-1 text-xs text-stone-500 hover:text-red-500 px-2 py-1 rounded-full border border-stone-200 hover:border-red-200 transition-colors">
        <i data-lucide="x" class="w-3 h-3"></i> Clear all
      </a>
    </div>
  <% } %>

  <div class="flex flex-col lg:flex-row gap-8">

    <!-- ── Sidebar Filters (desktop) / Drawer (mobile) ───────────────────── -->
    <aside id="filter-sidebar"
           class="hidden lg:block lg:w-60 shrink-0 lg:sticky lg:top-24 lg:self-start">
      <form action="/products" method="GET"
            class="bg-white rounded-2xl border border-stone-100 p-5 shadow-sm space-y-5">

        <div class="flex items-center justify-between">
          <h3 class="font-semibold text-stone-800 text-sm uppercase tracking-wider">Filters</h3>
          <a href="/products" class="text-xs text-stone-400 hover:text-red-400 transition-colors">Reset</a>
        </div>

        <!-- Type -->
        <div>
          <label class="text-xs font-medium text-stone-500 uppercase tracking-wider block mb-2">Type</label>
          <div class="space-y-1.5">
            <% ['rent','buy','sell'].forEach(t => { %>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="radio" name="type" value="<%= t %>"
                       <%= filters.type === t ? 'checked' : '' %>
                       onchange="this.form.submit()"
                       class="accent-brand-500" />
                <span class="text-sm text-stone-700 capitalize"><%= t %></span>
              </label>
            <% }) %>
          </div>
        </div>

        <!-- Category (dynamic by type) -->
        <div>
          <label class="text-xs font-medium text-stone-500 uppercase tracking-wider block mb-2">Category</label>
          <div class="space-y-1.5">
            <%
              const selectedType = filters.type;
              const availCats = selectedType
                ? categoryByType[selectedType]
                : ['furniture','appliance','decor','electronics','other'];
            %>
            <% availCats.forEach(c => { %>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="radio" name="category" value="<%= c %>"
                       <%= filters.category === c ? 'checked' : '' %>
                       onchange="this.form.submit()"
                       class="accent-brand-500" />
                <span class="text-sm text-stone-700 capitalize"><%= c %></span>
              </label>
            <% }) %>
          </div>
        </div>

        <!-- Subcategory (only if category selected) -->
        <% if (filters.category && subcategories[filters.category]) { %>
          <div>
            <label class="text-xs font-medium text-stone-500 uppercase tracking-wider block mb-2">Subcategory</label>
            <div class="space-y-1.5">
              <% subcategories[filters.category].forEach(s => { %>
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="radio" name="subcategory" value="<%= s %>"
                         <%= filters.subcategory === s ? 'checked' : '' %>
                         onchange="this.form.submit()"
                         class="accent-brand-500" />
                  <span class="text-sm text-stone-700 capitalize"><%= s %></span>
                </label>
              <% }) %>
            </div>
          </div>
        <% } %>

        <!-- Condition -->
        <div>
          <label class="text-xs font-medium text-stone-500 uppercase tracking-wider block mb-2">Condition</label>
          <div class="space-y-1.5">
            <% ['new','refurbished','used'].forEach(c => { %>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="radio" name="condition" value="<%= c %>"
                       <%= filters.condition === c ? 'checked' : '' %>
                       onchange="this.form.submit()"
                       class="accent-brand-500" />
                <span class="text-sm text-stone-700 capitalize"><%= c %></span>
              </label>
            <% }) %>
          </div>
        </div>

        <!-- Price Range -->
        <div>
          <label class="text-xs font-medium text-stone-500 uppercase tracking-wider block mb-2">
            Price (₹) <% if (filters.type === 'rent') { %><span class="normal-case font-normal">/month</span><% } %>
          </label>
          <div class="flex gap-2">
            <input type="number" name="minPrice" value="<%= filters.minPrice || '' %>"
                   placeholder="Min" min="0"
                   class="w-full border border-stone-200 rounded-lg px-2 py-1.5 text-xs focus:outline-none focus:ring-1 focus:ring-brand-300" />
            <input type="number" name="maxPrice" value="<%= filters.maxPrice || '' %>"
                   placeholder="Max" min="0"
                   class="w-full border border-stone-200 rounded-lg px-2 py-1.5 text-xs focus:outline-none focus:ring-1 focus:ring-brand-300" />
          </div>
        </div>

        <!-- City -->
        <div>
          <label class="text-xs font-medium text-stone-500 uppercase tracking-wider block mb-2">City</label>
          <input type="text" name="city" value="<%= filters.city || '' %>" placeholder="e.g. Mumbai"
                 class="w-full border border-stone-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-300" />
        </div>

        <!-- In Stock toggle -->
        <% if (!filters.type || filters.type === 'sell') { %>
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" name="inStock" value="true"
                   <%= filters.inStock === 'true' ? 'checked' : '' %>
                   class="accent-brand-500 w-4 h-4" />
            <span class="text-sm text-stone-700">Available only</span>
          </label>
        <% } %>

        <!-- Sort -->
        <div>
          <label class="text-xs font-medium text-stone-500 uppercase tracking-wider block mb-2">Sort By</label>
          <select name="sort" onchange="this.form.submit()"
                  class="w-full border border-stone-200 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-brand-300">
            <option value="newest"     <%= filters.sort === 'newest'     ? 'selected' : '' %>>Newest First</option>
            <option value="price_asc"  <%= filters.sort === 'price_asc'  ? 'selected' : '' %>>Price: Low → High</option>
            <option value="price_desc" <%= filters.sort === 'price_desc' ? 'selected' : '' %>>Price: High → Low</option>
          </select>
        </div>

        <div class="flex flex-col gap-2 pt-1">
          <button type="submit"
                  class="w-full bg-brand-500 hover:bg-brand-600 text-white py-2 rounded-lg text-sm font-medium transition-colors">
            Apply Filters
          </button>
          <a href="/products"
             class="w-full text-center border border-stone-200 text-stone-600 hover:bg-stone-50 py-2 rounded-lg text-sm transition-colors">
            Clear All
          </a>
        </div>
      </form>
    </aside>

    <!-- Mobile Filter Drawer Overlay -->
    <div id="filter-overlay"
         class="hidden fixed inset-0 bg-black/50 z-40 lg:hidden"
         onclick="closeFilterDrawer()"></div>

    <!-- Mobile Filter Drawer -->
    <div id="filter-drawer"
         class="hidden fixed bottom-0 left-0 right-0 bg-white z-50 rounded-t-2xl shadow-2xl lg:hidden overflow-y-auto"
         style="max-height:85vh;">
      <div class="sticky top-0 bg-white border-b border-stone-100 px-5 py-4 flex items-center justify-between">
        <h3 class="font-semibold text-stone-800">Filters</h3>
        <button onclick="closeFilterDrawer()" class="text-stone-400 hover:text-stone-700">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>
      <div class="p-5">
        <form action="/products" method="GET" class="space-y-5">
          <!-- Type -->
          <div>
            <label class="text-xs font-medium text-stone-500 uppercase tracking-wider block mb-2">Type</label>
            <div class="flex gap-2 flex-wrap">
              <% ['rent','buy','sell'].forEach(t => { %>
                <label class="cursor-pointer">
                  <input type="radio" name="type" value="<%= t %>" <%= filters.type === t ? 'checked' : '' %> class="sr-only peer" />
                  <span class="px-4 py-2 rounded-full border border-stone-200 text-sm capitalize peer-checked:bg-brand-500 peer-checked:text-white peer-checked:border-brand-500 transition-all">
                    <%= t %>
                  </span>
                </label>
              <% }) %>
            </div>
          </div>
          <!-- Category -->
          <div>
            <label class="text-xs font-medium text-stone-500 uppercase tracking-wider block mb-2">Category</label>
            <div class="flex gap-2 flex-wrap">
              <% const mCats = filters.type ? categoryByType[filters.type] : ['furniture','appliance','decor','electronics','other']; %>
              <% mCats.forEach(c => { %>
                <label class="cursor-pointer">
                  <input type="radio" name="category" value="<%= c %>" <%= filters.category === c ? 'checked' : '' %> class="sr-only peer" />
                  <span class="px-3 py-1.5 rounded-full border border-stone-200 text-xs capitalize peer-checked:bg-brand-500 peer-checked:text-white peer-checked:border-brand-500 transition-all">
                    <%= c %>
                  </span>
                </label>
              <% }) %>
            </div>
          </div>
          <!-- Condition -->
          <div>
            <label class="text-xs font-medium text-stone-500 uppercase tracking-wider block mb-2">Condition</label>
            <div class="flex gap-2">
              <% ['new','refurbished','used'].forEach(c => { %>
                <label class="cursor-pointer">
                  <input type="radio" name="condition" value="<%= c %>" <%= filters.condition === c ? 'checked' : '' %> class="sr-only peer" />
                  <span class="px-3 py-1.5 rounded-full border border-stone-200 text-xs capitalize peer-checked:bg-brand-500 peer-checked:text-white peer-checked:border-brand-500 transition-all">
                    <%= c %>
                  </span>
                </label>
              <% }) %>
            </div>
          </div>
          <!-- City -->
          <div>
            <label class="text-xs font-medium text-stone-500 uppercase tracking-wider block mb-2">City</label>
            <input type="text" name="city" value="<%= filters.city || '' %>" placeholder="e.g. Mumbai"
                   class="w-full border border-stone-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-300" />
          </div>
          <!-- Price -->
          <div>
            <label class="text-xs font-medium text-stone-500 uppercase tracking-wider block mb-2">Price Range (₹)</label>
            <div class="flex gap-3">
              <input type="number" name="minPrice" value="<%= filters.minPrice || '' %>" placeholder="Min"
                     class="w-full border border-stone-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-300" />
              <input type="number" name="maxPrice" value="<%= filters.maxPrice || '' %>" placeholder="Max"
                     class="w-full border border-stone-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-300" />
            </div>
          </div>
          <!-- Sort -->
          <div>
            <label class="text-xs font-medium text-stone-500 uppercase tracking-wider block mb-2">Sort By</label>
            <select name="sort" class="w-full border border-stone-200 rounded-xl px-4 py-2.5 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-brand-300">
              <option value="newest"     <%= filters.sort === 'newest'     ? 'selected' : '' %>>Newest First</option>
              <option value="price_asc"  <%= filters.sort === 'price_asc'  ? 'selected' : '' %>>Price: Low → High</option>
              <option value="price_desc" <%= filters.sort === 'price_desc' ? 'selected' : '' %>>Price: High → Low</option>
            </select>
          </div>
          <div class="flex gap-3 pt-2">
            <button type="submit"
                    class="flex-1 bg-brand-500 hover:bg-brand-600 text-white py-3 rounded-xl text-sm font-semibold transition-colors">
              Apply Filters
            </button>
            <a href="/products"
               class="flex-1 text-center border border-stone-200 text-stone-600 py-3 rounded-xl text-sm transition-colors">
              Clear All
            </a>
          </div>
        </form>
      </div>
    </div>

    <!-- ── Product Grid ──────────────────────────────────────────────────── -->
    <div class="flex-1 min-w-0">
      <% if (products.length === 0) { %>
        <div class="flex flex-col items-center justify-center py-24 text-center">
          <i data-lucide="search-x" class="w-14 h-14 text-stone-300 mb-4"></i>
          <h3 class="font-semibold text-stone-600 text-lg mb-1">No listings found</h3>
          <p class="text-stone-400 text-sm mb-6">Try adjusting your filters or search term</p>
          <a href="/products" class="text-brand-500 hover:underline text-sm font-medium">Clear filters</a>
        </div>
      <% } else { %>

        <!-- Skeleton -->
        <div id="skeletonGrid" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-5">
          <% for(let i = 0; i < 6; i++) { %>
            <div class="bg-white rounded-2xl border border-stone-100 p-4 shadow-sm animate-pulse">
              <div class="h-48 bg-stone-200 rounded-lg mb-4"></div>
              <div class="h-3 bg-stone-200 w-1/3 mb-2"></div>
              <div class="h-4 bg-stone-300 w-3/4 mb-2"></div>
              <div class="h-3 bg-stone-200 w-1/2 mb-4"></div>
              <div class="h-4 bg-stone-300 w-1/4"></div>
            </div>
          <% } %>
        </div>

        <!-- Real Grid -->
        <div id="realGrid" class="hidden">
          <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-5">
            <% products.forEach(product => { %>
              <a href="/products/<%= product._id %>"
                 class="group bg-white rounded-2xl border border-stone-100 overflow-hidden shadow-sm hover:shadow-md transition-all hover:-translate-y-1">

                <!-- Image -->
                <div class="relative overflow-hidden h-48 bg-stone-100">
                  <img src="<%= product.images[0]?.url || 'https://placehold.co/400x300?text=No+Image' %>"
                       alt="<%= product.title %>"
                       class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                  <!-- Badges -->
                  <div class="absolute top-3 left-3 flex gap-1.5 flex-wrap">
                    <span class="text-xs font-semibold px-2.5 py-1 rounded-full capitalize
                      <%= product.type === 'rent' ? 'bg-blue-100 text-blue-700' :
                          product.type === 'buy'  ? 'bg-emerald-100 text-emerald-700' :
                                                    'bg-amber-100 text-amber-700' %>">
                      <%= product.type %>
                    </span>
                    <% if (product.condition) { %>
                      <span class="text-xs font-medium px-2 py-1 rounded-full bg-white/80 text-stone-600 capitalize">
                        <%= product.condition %>
                      </span>
                    <% } %>
                    <% if (!product.isAvailable || (product.type !== 'sell' && product.availableStock === 0)) { %>
                      <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-red-100 text-red-700">
                        Out of Stock
                      </span>
                    <% } %>
                  </div>
                  <!-- Stock badge for rent/buy -->
                  <% if ((product.type === 'rent' || product.type === 'buy') && product.availableStock > 0) { %>
                    <div class="absolute top-3 right-3 bg-green-600 text-white text-xs px-2 py-0.5 rounded-full">
                      In Stock
                    </div>
                  <% } %>
                </div>

                <!-- Body -->
                <div class="p-4">
                  <p class="text-xs text-stone-400 capitalize mb-1"><%= product.category %><% if (product.subcategory) { %> · <%= product.subcategory %><% } %></p>
                  <h3 class="font-semibold text-stone-900 truncate mb-2"><%= product.title %></h3>
                  <div class="flex items-center gap-1 text-stone-400 text-xs mb-3">
                    <!-- Ownership -->
                    <span class="mr-auto flex items-center">
                      <i data-lucide="user" class="w-3 h-3"></i>
                      <% if (product.ownerType === 'platform') { %>
                        <span class="text-gray-800 font-medium">Home Harmony</span>
                      <% } else { %>
                        <span><%= product.owner?.username || 'Unknown' %></span>
                      <% } %>
                    </span>
                  </div>
                  <div class="flex items-center justify-between">
                    <div>
                      <% if (product.type === 'rent' && product.rentPerMonth) { %>
                        <span class="text-lg font-bold text-stone-900">₹<%= product.rentPerMonth.toLocaleString('en-IN') %></span><span class="text-xs text-stone-400 ml-1">/month</span>
                      <% } else {%>
                        <span class="text-lg font-bold text-stone-900">₹<%= product.price.toLocaleString('en-IN') %></span>
                      <%}%>
                    </div>
                    <div class="flex items-center gap-1 text-amber-400 text-xs">
                      <i data-lucide="star" class="w-3.5 h-3.5 fill-amber-400"></i>
                      <span class="text-stone-600 font-medium"><%= product.averageRating || '—' %></span>
                    </div>
                  </div>
                </div>
              </a>
            <% }) %>
          </div>

          <!-- Pagination -->
          <div class="flex justify-center mt-10 space-x-2">
            <% const qp = Object.entries(filters).filter(([k]) => k !== 'page').map(([k,v]) => `${k}=${encodeURIComponent(v)}`).join('&'); %>
            <% if (currentPage > 1) { %>
              <a href="?page=<%= currentPage - 1 %>&<%= qp %>"
                 class="px-4 py-2 bg-stone-200 rounded-lg hover:bg-stone-300 text-sm">Prev</a>
            <% } %>
            <% for(let i = 1; i <= totalPages; i++) { %>
              <a href="?page=<%= i %>&<%= qp %>"
                 class="px-4 py-2 rounded-lg text-sm <%= currentPage === i ? 'bg-brand-500 text-white' : 'bg-stone-100 hover:bg-stone-200' %>">
                <%= i %>
              </a>
            <% } %>
            <% if (currentPage < totalPages) { %>
              <a href="?page=<%= currentPage + 1 %>&<%= qp %>"
                 class="px-4 py-2 bg-stone-200 rounded-lg hover:bg-stone-300 text-sm">Next</a>
            <% } %>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</div>

<script>
  // Mobile filter drawer
  function closeFilterDrawer() {
    document.getElementById('filter-drawer').classList.add('hidden');
    document.getElementById('filter-overlay').classList.add('hidden');
    document.body.style.overflow = '';
  }
  document.getElementById('filter-toggle')?.addEventListener('click', () => {
    document.getElementById('filter-drawer').classList.remove('hidden');
    document.getElementById('filter-overlay').classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    lucide.createIcons();
  });
</script>
