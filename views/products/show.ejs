<%- layout('boilerplate') %>

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

    <!-- ── Left: Images + Details ─────────────────────────────────────────── -->
    <div class="lg:col-span-2 space-y-6">

      <!-- Back -->
      <a href="/products"
         class="inline-flex items-center gap-1.5 text-sm text-stone-500 hover:text-brand-500 transition-colors">
        <i data-lucide="arrow-left" class="w-4 h-4"></i> Back to listings
      </a>

      <!-- Main Image -->
      <div class="rounded-2xl overflow-hidden bg-stone-100 aspect-video">
        <img src="<%= product.images[0] ? product.images[0].url : 'https://placehold.co/800x500?text=No+Image' %>"
             alt="<%= product.title %>"
             class="w-full h-full object-cover" />
      </div>

      <!-- Thumbnails -->
      <% if (product.images.length > 1) { %>
        <div class="flex gap-3 overflow-x-auto pb-1">
          <% product.images.forEach(function(img, i) { %>
            <img src="<%= img.url %>"
                 alt="Image <%= i + 1 %>"
                 class="w-20 h-20 object-cover rounded-xl border-2 border-stone-200
                        cursor-pointer hover:border-brand-400 transition-colors shrink-0" />
          <% }); %>
        </div>
      <% } %>

      <!-- Badges + Title -->
      <div>
        <div class="flex flex-wrap items-center gap-2 mb-3">

          <% if (product.type === 'rent') { %>
            <span class="text-xs font-semibold px-2.5 py-1 rounded-full capitalize bg-blue-100 text-blue-700">
              <%= product.type %>
            </span>
          <% } else if (product.type === 'buy') { %>
            <span class="text-xs font-semibold px-2.5 py-1 rounded-full capitalize bg-emerald-100 text-emerald-700">
              <%= product.type %>
            </span>
          <% } else { %>
            <span class="text-xs font-semibold px-2.5 py-1 rounded-full capitalize bg-amber-100 text-amber-700">
              <%= product.type %>
            </span>
          <% } %>

          <span class="text-xs px-2.5 py-1 rounded-full bg-stone-100 text-stone-600 capitalize">
            <%= product.category %>
          </span>

          <% if (product.status === 'available') { %>
            <span class="text-xs px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-700 capitalize">
              <%= product.status %>
            </span>
          <% } else { %>
            <span class="text-xs px-2.5 py-1 rounded-full bg-red-100 text-red-700 capitalize">
              <%= product.status %>
            </span>
          <% } %>

        </div>

        <h1 class="font-display text-3xl font-bold text-stone-900 mb-2">
          <%= product.title %>
        </h1>

        <div class="flex items-center gap-4 text-stone-500 text-sm mb-5">
          <span class="flex items-center gap-1.5">
            <i data-lucide="map-pin" class="w-4 h-4"></i>
            <%= product.city %><% if (product.location) { %>, <%= product.location %><% } %>
          </span>
          <span class="flex items-center gap-1.5">
            <i data-lucide="star" class="w-4 h-4 text-amber-400 fill-amber-400"></i>
            <%= product.averageRating || 'No ratings' %>
            (<%= product.reviews.length %> review<%= product.reviews.length !== 1 ? 's' : '' %>)
          </span>
        </div>

        <p class="text-stone-600 leading-relaxed"><%= product.description %></p>
      </div>

      <!-- Owner Actions -->
      <% if (currentUser && product.owner._id.equals(currentUser._id)) { %>
        <div class="flex gap-3 pt-2">
          <a href="/products/<%= product._id %>/edit"
             class="flex items-center gap-2 border border-stone-200 text-stone-700
                    hover:bg-stone-50 px-5 py-2.5 rounded-xl text-sm font-medium transition-colors">
            <i data-lucide="pencil" class="w-4 h-4"></i> Edit Listing
          </a>
          <form action="/products/<%= product._id %>?_method=DELETE" method="POST"
                onsubmit="return confirm('Are you sure you want to delete this listing?')">
            <button type="submit"
                    class="flex items-center gap-2 bg-red-50 border border-red-200 text-red-600
                           hover:bg-red-100 px-5 py-2.5 rounded-xl text-sm font-medium transition-colors">
              <i data-lucide="trash-2" class="w-4 h-4"></i> Delete
            </button>
          </form>
        </div>
      <% } %>

      <!-- ── MapBox Map ──────────────────────────────────────────────────── -->
      <% if (product.geometry && product.geometry.coordinates[0] !== 0) { %>
        <div class="pt-2">
          <h3 class="font-semibold text-stone-800 mb-3 flex items-center gap-2">
            <i data-lucide="map-pin" class="w-4 h-4 text-brand-500"></i> Location
          </h3>
          <div id="map" class="w-full h-64 rounded-2xl overflow-hidden border border-stone-100 shadow-sm"></div>
        </div>
      <% } %>

      <!-- ── Reviews Section ────────────────────────────────────────────── -->
      <div class="pt-4 border-t border-stone-100">
        <h2 class="font-display text-2xl font-bold text-stone-900 mb-6">Reviews</h2>

        <!-- Review Form -->
        <% if (currentUser && !product.owner._id.equals(currentUser._id)) { %>
          <div class="bg-stone-50 rounded-2xl border border-stone-100 p-6 mb-6">
            <h3 class="font-semibold text-stone-800 mb-4">Leave a Review</h3>
            <form action="/products/<%= product._id %>/reviews" method="POST" class="space-y-4">

              <div>
                <label class="text-sm font-medium text-stone-600 block mb-2">Rating</label>
                <div class="flex gap-1" id="star-container">
                  <% for (let i = 1; i <= 5; i++) { %>
                    <button type="button" data-val="<%= i %>"
                            class="star-btn w-8 h-8 text-stone-300 hover:text-amber-400 transition-colors text-xl">
                      ★
                    </button>
                  <% } %>
                </div>
                <input type="hidden" name="review[rating]" id="rating-input" value="5" required />
              </div>

              <div>
                <label class="text-sm font-medium text-stone-600 block mb-1.5" for="comment">
                  Comment
                </label>
                <textarea name="review[comment]" id="comment" rows="3" required
                          placeholder="Share your experience with this listing..."
                          class="w-full border border-stone-200 rounded-xl px-4 py-3 text-sm
                                 focus:outline-none focus:ring-2 focus:ring-brand-300 resize-none bg-white">
                </textarea>
              </div>

              <button type="submit"
                      class="bg-brand-500 hover:bg-brand-600 text-white px-6 py-2.5
                             rounded-xl text-sm font-medium transition-colors">
                Submit Review
              </button>
            </form>
          </div>
        <% } %>

        <!-- Review List -->
        <% if (product.reviews.length === 0) { %>
          <p class="text-stone-400 text-sm py-4">No reviews yet. Be the first to review!</p>
        <% } else { %>
          <div class="space-y-4">
            <% product.reviews.forEach(function(review) { %>
              <div class="bg-white rounded-2xl border border-stone-100 p-5 shadow-sm">
                <div class="flex items-start justify-between">
                  <div class="flex items-center gap-3">
                    <img src="<%= review.author.avatar.url %>"
                         alt="<%= review.author.username %>"
                         class="w-9 h-9 rounded-full object-cover border border-stone-100" />
                    <div>
                      <p class="font-medium text-stone-800 text-sm"><%= review.author.username %></p>
                      <p class="text-xs text-stone-400">
                        <%= new Date(review.createdAt).toLocaleDateString('en-IN', {
                          day: 'numeric', month: 'short', year: 'numeric'
                        }) %>
                      </p>
                    </div>
                  </div>
                  <div class="flex items-center gap-0.5">
                    <% for (let i = 1; i <= 5; i++) { %>
                      <% if (i <= review.rating) { %>
                        <i data-lucide="star" class="w-3.5 h-3.5 text-amber-400 fill-amber-400"></i>
                      <% } else { %>
                        <i data-lucide="star" class="w-3.5 h-3.5 text-stone-200"></i>
                      <% } %>
                    <% } %>
                  </div>
                </div>

                <p class="text-stone-600 text-sm mt-3 leading-relaxed"><%= review.comment %></p>

                <% if (currentUser && review.author._id.equals(currentUser._id)) { %>
                  <form action="/products/<%= product._id %>/reviews/<%= review._id %>?_method=DELETE"
                        method="POST" class="mt-3">
                    <button type="submit"
                            class="text-xs text-red-400 hover:text-red-600
                                   flex items-center gap-1 transition-colors">
                      <i data-lucide="trash-2" class="w-3 h-3"></i> Delete
                    </button>
                  </form>
                <% } %>
              </div>
            <% }); %>
          </div>
        <% } %>
      </div>
    </div>

    <!-- ── Right: Price Card ───────────────────────────────────────────────── -->
    <div class="lg:col-span-1">
      <div class="sticky top-24 bg-white rounded-2xl border border-stone-100 shadow-md p-6 space-y-4">

        <!-- Price -->
        <div>
          <p class="text-sm text-stone-400 mb-0.5">Price</p>
          <p class="text-3xl font-display font-bold text-stone-900">
            ₹<%= product.price.toLocaleString('en-IN') %>
            <% if (product.type === 'rent') { %>
              <span class="text-base font-normal text-stone-400">/ month</span>
            <% } %>
          </p>
          <% if (product.type === 'rent' && product.rentPerMonth) { %>
            <p class="text-sm text-stone-500 mt-1">
              Monthly rent: ₹<%= product.rentPerMonth.toLocaleString('en-IN') %>
            </p>
          <% } %>
        </div>

        <!-- Primary CTA -->
        <% if (product.status === 'available') { %>
          <% if (currentUser && !product.owner._id.equals(currentUser._id)) { %>
            <button class="w-full bg-brand-500 hover:bg-brand-600 text-white
                           font-semibold py-3 rounded-xl transition-colors shadow-sm">
              <% if (product.type === 'rent') { %>
                🏠 Request to Rent
              <% } else if (product.type === 'buy') { %>
                🛒 Buy Now
              <% } else { %>
                💬 Contact Seller
              <% } %>
            </button>
          <% } else if (!currentUser) { %>
            <a href="/auth/login"
               class="w-full block text-center bg-brand-500 hover:bg-brand-600
                      text-white font-semibold py-3 rounded-xl transition-colors shadow-sm">
              Sign in to
              <% if (product.type === 'rent') { %>Rent
              <% } else if (product.type === 'buy') { %>Buy
              <% } else { %>Contact<% } %>
            </a>
          <% } %>
        <% } else { %>
          <div class="w-full bg-stone-100 text-stone-500 font-semibold
                      py-3 rounded-xl text-center capitalize">
            <%= product.status %>
          </div>
        <% } %>

        <!-- Razorpay Pay Button -->
        <% if (currentUser && product.status === 'available' && !product.owner._id.equals(currentUser._id)) { %>
          <button id="pay-btn" onclick="initiatePayment()"
                  class="w-full flex items-center justify-center gap-2 bg-stone-900
                         hover:bg-stone-800 text-white font-semibold py-3 rounded-xl
                         transition-colors shadow-sm">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M14.5 2L19 9H14.5L12 14L9.5 9H5L9.5 2H14.5Z"/>
            </svg>
            Pay with Razorpay
          </button>
        <% } %>

        <!-- Meta Info -->
        <div class="border-t border-stone-100 pt-4 space-y-3">
          <div class="flex items-center gap-3 text-sm text-stone-500">
            <i data-lucide="user" class="w-4 h-4 text-stone-400 shrink-0"></i>
            <span>
              Listed by <strong class="text-stone-700"><%= product.owner.username %></strong>
            </span>
          </div>
          <div class="flex items-center gap-3 text-sm text-stone-500">
            <i data-lucide="calendar" class="w-4 h-4 text-stone-400 shrink-0"></i>
            <span>
              <%= new Date(product.createdAt).toLocaleDateString('en-IN', {
                day: 'numeric', month: 'long', year: 'numeric'
              }) %>
            </span>
          </div>
          <div class="flex items-center gap-3 text-sm text-stone-500">
            <i data-lucide="shield-check" class="w-4 h-4 text-emerald-400 shrink-0"></i>
            <span class="text-emerald-600">Verified Listing</span>
          </div>
        </div>

      </div>
    </div>

  </div>
</div>

<!-- ══════════════════════════════════════════════════════════════════════════ -->
<!--  MapBox GL JS — only loads if product has valid coordinates               -->
<!-- ══════════════════════════════════════════════════════════════════════════ -->
<% if (product.geometry && product.geometry.coordinates[0] !== 0) { %>
  <link href="https://api.mapbox.com/mapbox-gl-js/v3.3.0/mapbox-gl.css" rel="stylesheet" />
  <script src="https://api.mapbox.com/mapbox-gl-js/v3.3.0/mapbox-gl.js"></script>
  <script>
    mapboxgl.accessToken = '<%- mapboxToken %>';

    var coords = <%- JSON.stringify(product.geometry.coordinates) %>;
    var title  = '<%= product.title.replace(/'/g, "\\'") %>';
    var city   = '<%= product.city.replace(/'/g, "\\'") %>';

    var map = new mapboxgl.Map({
      container:  'map',
      style:      'mapbox://styles/mapbox/light-v11',
      center:     coords,
      zoom:       12,
      scrollZoom: false,
    });

    new mapboxgl.Marker({ color: '#dc7420' })
      .setLngLat(coords)
      .setPopup(
        new mapboxgl.Popup({ offset: 25 })
          .setHTML('<strong>' + title + '</strong><br/>' + city)
      )
      .addTo(map);

    map.addControl(new mapboxgl.NavigationControl(), 'top-right');
  </script>
<% } %>

<!-- ══════════════════════════════════════════════════════════════════════════ -->
<!--  Razorpay — only loads if user is logged in and not the owner             -->
<!-- ══════════════════════════════════════════════════════════════════════════ -->
<% if (currentUser && product.status === 'available' && !product.owner._id.equals(currentUser._id)) { %>
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
  var RAZORPAY_KEY   = '<%= razorpayKey %>';
  var PRODUCT_ID     = '<%= product._id %>';
  var PRODUCT_TITLE  = '<%= product.title.replace(/'/g, "\\'") %>';
  var PRODUCT_AMOUNT = <%= (product.type === 'rent' && product.rentPerMonth) ? product.rentPerMonth : product.price %>;
  var USER_NAME      = '<%= currentUser.username.replace(/'/g, "\\'") %>';
  var USER_EMAIL     = '<%= currentUser.email %>';

  // ── Toast helper (no more ugly browser alerts) ──────────────────────────────
  function showToast(message, type) {
    var existing = document.getElementById('pay-toast');
    if (existing) existing.remove();

    var toast = document.createElement('div');
    toast.id  = 'pay-toast';
    toast.style.cssText = [
      'position:fixed',
      'bottom:24px',
      'right:24px',
      'z-index:9999',
      'padding:14px 20px',
      'border-radius:12px',
      'font-size:14px',
      'font-weight:500',
      'font-family:"DM Sans",sans-serif',
      'box-shadow:0 8px 24px rgba(0,0,0,0.12)',
      'display:flex',
      'align-items:center',
      'gap:10px',
      'max-width:360px',
      'animation:slideUp 0.3s ease',
      type === 'success'
        ? 'background:#f0fdf4;border:1px solid #bbf7d0;color:#166534'
        : 'background:#fef2f2;border:1px solid #fecaca;color:#991b1b',
    ].join(';');

    toast.innerHTML = (type === 'success' ? '✅ ' : '❌ ') + message;
    document.body.appendChild(toast);

    setTimeout(function() {
      toast.style.opacity = '0';
      toast.style.transition = 'opacity 0.4s ease';
      setTimeout(function() { toast.remove(); }, 400);
    }, 4000);
  }

  // ── Add slideUp keyframe once ────────────────────────────────────────────────
  if (!document.getElementById('toast-style')) {
    var style = document.createElement('style');
    style.id  = 'toast-style';
    style.textContent = '@keyframes slideUp { from { opacity:0; transform:translateY(16px); } to { opacity:1; transform:translateY(0); } }';
    document.head.appendChild(style);
  }

  // ── Main payment function ────────────────────────────────────────────────────
  async function initiatePayment() {
    var btn = document.getElementById('pay-btn');
    var originalHTML = btn.innerHTML;

    btn.disabled   = true;
    btn.innerHTML  = '<svg class="animate-spin w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg> Processing...';

    try {
      // Step 1 — Create order on server
      var res = await fetch('/payment/create-order', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          amount:       PRODUCT_AMOUNT,
          productId:    PRODUCT_ID,
          productTitle: PRODUCT_TITLE,
        }),
      });

      var data = await res.json();
      if (!data.success) throw new Error('Could not create payment order.');

      // Step 2 — Open Razorpay modal
      var options = {
        key:         RAZORPAY_KEY,
        amount:      data.order.amount,
        currency:    'INR',
        name:        'Home Harmony',
        description: PRODUCT_TITLE,
        order_id:    data.order.id,
        prefill: {
          name:  USER_NAME,
          email: USER_EMAIL,
        },
        theme: { color: '#dc7420' },

        // Step 3 — Verify on success
        handler: async function(response) {
          try {
            var verify = await fetch('/payment/verify', {
              method:  'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(response),
            });
            var result = await verify.json();

            if (result.success) {
              showToast('Payment successful! ID: ' + result.paymentId, 'success');
              // Redirect after 2 seconds so user can read the toast
              setTimeout(function() {
                window.location.reload();
              }, 2000);
            } else {
              showToast('Payment verification failed. Please contact support.', 'error');
            }
          } catch (e) {
            showToast('Verification error. Please contact support.', 'error');
          }
        },
      };

      var rzp = new Razorpay(options);

      rzp.on('payment.failed', function(response) {
        showToast('Payment failed: ' + response.error.description, 'error');
      });

      rzp.open();

    } catch (err) {
      console.error('Payment error:', err);
      showToast('Something went wrong. Please try again.', 'error');
    } finally {
      btn.disabled  = false;
      btn.innerHTML = originalHTML;
      lucide.createIcons();
    }
  }
</script>
<% } %>